# Copy to .env and fill in. Never commit the real .env.

# --- Django ---
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- AI / transcription ---
OPENAI_API_KEY=          # notes + RAG embeddings
APIKEY=                  # AssemblyAI (MP3 -> transcript)
SERP_API=                # SerpAPI (YouTube transcript fetch, optional)

# --- PostgreSQL (+ pgvector) ---
PGDATABASE=notetube
PGUSER=postgres
PGPASSWORD=
PGHOST=localhost
PGPORT=5432

# --- Redis (broker, cache, RAG semantic cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube (optional) ---
YTDLP_COOKIES_FILE=      # path to cookies.txt; improves restricted-video access
